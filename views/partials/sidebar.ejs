<div class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse" id="sidebarMenu">
    <div class="position-sticky pt-3">
        <div class="d-flex justify-content-center mb-4">
            <div class="text-center">
                <img src="/img/logo.png" alt="AiTrade Bot" class="img-fluid mb-2" style="max-width: 80px;">
                <h4 class="text-primary">AiTrade Bot</h4>
            </div>
        </div>
        
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Ana Sayfa
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/positions' ? 'active' : '' %>" href="/positions">
                    <i class="bi bi-graph-up me-2"></i>
                    Pozisyonlar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/settings' ? 'active' : '' %>" href="/settings">
                    <i class="bi bi-gear me-2"></i>
                    İşlem Ayarları
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/api-settings' ? 'active' : '' %>" href="/api-settings">
                    <i class="bi bi-key me-2"></i>
                    API Ayarları
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/auto-trade' ? 'active' : '' %>" href="/auto-trade">
                    <i class="bi bi-robot me-2"></i>
                    Oto-İşlem
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/license' ? 'active' : '' %>" href="/license">
                    <i class="bi bi-shield-check me-2"></i>
                    Lisans
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/notifications' ? 'active' : '' %>" href="/notifications">
                    <i class="bi bi-bell me-2"></i>
                    Bildirimler
                    <span id="sidebar-notification-badge" class="badge bg-danger" style="display: none;">0</span>
                </a>
            </li>
        </ul>
        
        <% if (isAdmin) { %>
        <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
            <span>Admin Paneli</span>
        </h6>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">
                    <i class="bi bi-cpu me-2"></i>
                    Ana Sayfa
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/admin/users' ? 'active' : '' %>" href="/admin/users">
                    <i class="bi bi-people me-2"></i>
                    Kullanıcılar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/admin/create-key' ? 'active' : '' %>" href="/admin/create-key">
                    <i class="bi bi-key-fill me-2"></i>
                    Lisans Oluştur
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/admin/license-keys' ? 'active' : '' %>" href="/admin/license-keys">
                    <i class="bi bi-list-check me-2"></i>
                    Lisans Anahtarları
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/admin/subscribers' ? 'active' : '' %>" href="/admin/subscribers">
                    <i class="bi bi-person-badge me-2"></i>
                    Aboneler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= currentPath === '/admin/send-message' ? 'active' : '' %>" href="/admin/send-message">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Mesaj Gönder
                </a>
            </li>
        </ul>
        <% } %>
        
        <div class="mt-5 mb-3 border-top pt-3">
            <div class="d-grid gap-2 px-3">
                <a href="/logout" class="btn btn-danger">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    Çıkış Yap
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Mobil Menü Overlay -->
<div class="mobile-menu-overlay d-md-none" id="mobileMenuOverlay"></div>

<!-- Mobil Kullanıcı Menüsü -->
<div class="mobile-menu d-md-none" id="mobileUserMenu">
    <div class="mobile-menu-header">
        <h5 class="mb-0">Kullanıcı Menüsü</h5>
        <button type="button" class="btn-close" id="mobileUserMenuClose"></button>
    </div>
    <div class="list-group list-group-flush">
        <a href="/dashboard" class="list-group-item list-group-item-action">
            <i class="bi bi-speedometer2 me-2"></i> Ana Sayfa
        </a>
        <a href="/settings" class="list-group-item list-group-item-action">
            <i class="bi bi-gear me-2"></i> Ayarlar
        </a>
        <a href="/notifications" class="list-group-item list-group-item-action">
            <i class="bi bi-bell me-2"></i> Bildirimler
            <span id="mobile-notification-badge" class="badge bg-danger float-end" style="display: none;">0</span>
        </a>
        <a href="/logout" class="list-group-item list-group-item-action text-danger">
            <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
        </a>
    </div>
</div>