<div class="container-fluid">
    <h1 class="h2 mb-4">Aboneler</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Aktif Aboneler</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Kullanıcı Adı</th>
                                    <th>E-posta</th>
                                    <th>Abonelik Bitiş</th>
                                    <th>Kalan Gün</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.subscribers && subscribers.length > 0) { %>
                                    <% subscribers.forEach(subscriber => { %>
                                        <tr>
                                            <td><%= subscriber.id %></td>
                                            <td><%= subscriber.username %></td>
                                            <td><%= subscriber.email %></td>
                                            <td><%= new Date(subscriber.subscription_end).toLocaleString() %></td>
                                            <td>
                                                <% 
                                                    const endDate = new Date(subscriber.subscription_end);
                                                    const today = new Date();
                                                    const days = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
                                                %>
                                                <% if (days > 30) { %>
                                                    <span class="badge bg-success"><%= days %> gün</span>
                                                <% } else if (days > 7) { %>
                                                    <span class="badge bg-info"><%= days %> gün</span>
                                                <% } else { %>
                                                    <span class="badge bg-danger"><%= days %> gün</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center">Aktif abone bulunamadı</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Abone İstatistikleri</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Toplam Abone</h6>
                        <h2 class="text-primary"><%= locals.subscribers ? subscribers.length : 0 %></h2>
                    </div>
                    
                    <div class="mb-3">
                        <h6>7 Günden Az Kalan Aboneler</h6>
                        <h2 class="text-danger">
                            <%= 
                                locals.subscribers 
                                ? subscribers.filter(s => {
                                    const endDate = new Date(s.subscription_end);
                                    const today = new Date();
                                    const days = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
                                    return days <= 7;
                                }).length 
                                : 0 
                            %>
                        </h2>
                    </div>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Hızlı İşlemler</h5>
                </div>
                <div class="card-body">
                    <a href="/admin/create-key" class="btn btn-success mb-2 w-100">
                        <i class="bi bi-key me-1"></i> Lisans Anahtarı Oluştur
                    </a>
                    <a href="/admin/license-keys" class="btn btn-info mb-2 w-100 text-white">
                        <i class="bi bi-list me-1"></i> Lisans Anahtarları
                    </a>
                    <a href="/admin/send-message" class="btn btn-warning mb-2 w-100">
                        <i class="bi bi-chat-left-text me-1"></i> Abonelere Mesaj Gönder
                    </a>
                    <a href="/admin" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-left me-1"></i> Admin Paneline Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>