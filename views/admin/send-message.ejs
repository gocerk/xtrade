<div class="container">
    <h1 class="h2 mb-4">Abonelere Mesaj Gönder</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Mesaj Formu</h5>
                </div>
                <div class="card-body">
                    <form action="/admin/send-message" method="POST">
                        <div class="mb-3">
                            <label for="message" class="form-label">Mesaj İçeriği</label>
                            <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                            <div class="form-text">Bu mesaj tüm aktif abonelere gönderilecektir.</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="messageType" class="form-label">Mesaj Tipi</label>
                            <select class="form-select" id="messageType" name="messageType">
                                <option value="info" selected>Bilgi</option>
                                <option value="success">Başarı</option>
                                <option value="warning">Uyarı</option>
                                <option value="error">Hata</option>
                            </select>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="/admin" class="btn btn-outline-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary">Mesajı Gönder</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Bilgi</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <h5>Önemli Bilgi!</h5>
                        <p>Bu sayfadan gönderdiğiniz mesajlar tüm aktif abonelere anında bildirim olarak iletilecektir.</p>
                    </div>
                    
                    <p><strong>Mesaj Tipleri:</strong></p>
                    <ul>
                        <li><span class="badge bg-info">Bilgi</span> - Genel bilgilendirme mesajları</li>
                        <li><span class="badge bg-success">Başarı</span> - Olumlu duyurular</li>
                        <li><span class="badge bg-warning">Uyarı</span> - Dikkat edilmesi gereken konular</li>
                        <li><span class="badge bg-danger">Hata</span> - Acil durumlar veya hatalar</li>
                    </ul>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Hızlı İşlemler</h5>
                </div>
                <div class="card-body">
                    <a href="/admin/subscribers" class="btn btn-info mb-2 w-100 text-white">
                        <i class="bi bi-people me-1"></i> Aboneleri Görüntüle
                    </a>
                    <a href="/admin" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-left me-1"></i> Admin Paneline Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>